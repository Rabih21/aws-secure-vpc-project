{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListProjectBucket",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::YOUR-PROJECT-BUCKET"
        },
        {
            "Sid": "ReadProjectBucketObjects",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::YOUR-PROJECT-BUCKET/*"
        }
    ]
}